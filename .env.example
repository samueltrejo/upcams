# Paste the four stream URLs generated by UniFi Protect here.
#
# On a trusted local network, an RTSPS URL such as:
#   rtsps://192.168.1.10:7441/STREAM_TOKEN?enableSrtp
# can usually be used as local RTSP by changing it to:
#   rtsp://192.168.1.10:7447/STREAM_TOKEN
#
# These should point to your Protect console/NVR, not the individual camera IPs.

CAMERA_1_URL=rtsp://192.168.1.10:7447/PASTE_CAMERA_1_TOKEN
CAMERA_2_URL=rtsp://192.168.1.10:7447/PASTE_CAMERA_2_TOKEN
CAMERA_3_URL=rtsp://192.168.1.10:7447/PASTE_CAMERA_3_TOKEN
CAMERA_4_URL=rtsp://192.168.1.10:7447/PASTE_CAMERA_4_TOKEN

# The stable LAN IP or local DNS name clients will type into the browser.
# It must match exactly because the HTTPS certificate is issued for this value.
# Desktop example: 192.168.0.203
# Ubuntu server example: 192.168.0.50
CAMERA_APP_HOST=192.168.0.203
CAMERA_HTTPS_PORT=8443
